{
  "name": "osprey",
  "version": "0.1.0",
  "private": true,
  "description": "Osprey - SBOM security auditing and CISA KEV vulnerability detection tool",
  "type": "module",
  "bin": {
    "cra": "./dist/cli/audit.js",
    "cra-sbom": "./dist/cli/generate-sbom.js",
    "cra-kev": "./dist/cli/kev-check.js",
    "cra-audit": "./dist/cli/audit.js",
    "cra-report": "./dist/cli/report-sboim.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepare": "npm run build",
    "cra": "tsx cli/audit.ts",
    "sbom": "tsx cli/generate-sbom.ts",
    "kev": "tsx cli/kev-check.ts",
    "report": "tsx cli/report-sboim.ts",
    "audit": "tsx cli/audit.ts",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "files": ["dist", "README.md"],
  "dependencies": {
    "@aws-sdk/client-s3": "^3.658.0",
    "zod": "^3.23.8",
    "commander": "^12.1.0",
    "semver": "^7.8.5"
  },
  "devDependencies": {
    "typescript": "^5.6.0",
    "tsx": "^4.19.0",
    "vitest": "^2.1.0",
    "@types/node": "^22.5.0",
    "@types/semver": "^7.8.0"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
